# --- Database -------------------------------------------------------------
# SQLite by default. Point this at Postgres later and change the provider in
# prisma/schema.prisma to "postgresql" - nothing else in the code changes.
DATABASE_URL="file:./dev.db"

# --- Sessions -------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
# Changing this logs everybody out. Never commit the real value.
SESSION_SECRET="change-me-openssl-rand-base64-48"

# Session cookies are marked Secure in production, so the browser only sends them
# back over HTTPS. Set this to false ONLY while running a demo on plain http with
# no certificate - otherwise sign-in appears to work and then does nothing.
# SECURE_COOKIES="false"

# --- Price source ---------------------------------------------------------
# simulated  = built-in deterministic feed, works offline, no signup (default)
# ecb        = real daily reference rates from frankfurter.app (free, no API key),
#              with intraday movement synthesised around the real close
PRICE_SOURCE="simulated"

# --- News strip -----------------------------------------------------------
# Comma-separated RSS feeds shown on the trading dashboard. Leave empty to hide.
NEWS_FEEDS="https://www.fxstreet.com/rss/news,https://www.investing.com/rss/news_1.rss"

# --- Seed admin (used only by `npm run db:seed`) ---------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
